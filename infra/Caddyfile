{
	auto_https off
	admin off
}
import /etc/caddy/static-serving.caddy
:4300 {
	@api path /api /api/*
	handle @api {
		reverse_proxy api:4302 {
			flush_interval -1
		}
	}
	@admin path /admin /admin/*
	redir @admin {$TOROBTICKET_ADMIN_ORIGIN}{uri} 308
	handle {
		root * /srv/web
		import static-serving hashed_web
	}
}
