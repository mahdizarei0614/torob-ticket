{
  "name": "@torob-ticket/workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.17.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "start": "nx run-many -t serve --projects=web,admin,api --parallel=3",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build --projects=web,admin,api",
    "test": "pnpm test:tools && nx run-many -t test",
    "verify": "nx run-many -t lint,typecheck,test,build",
    "verify:release": "node tools/verify-release.mjs",
    "verify:boundaries": "node tools/verify-boundaries.mjs",
    "affected": "nx affected -t lint,typecheck,test,build",
    "generate:library": "node tools/generators/library/generate.mjs",
    "test:tools": "node --test tools/test-docker-runner.mjs tools/test-dev-api.mjs tools/test-test-database.mjs && node tools/test-generator.mjs && node tools/test-cache-inputs.mjs && node tools/test-ui-asset-inputs.mjs && node tools/test-fixture-asset-inputs.mjs && node tools/test-graphics-asset-inputs.mjs && node tools/generate-route-scene-fixtures.mjs --check",
    "test:cache": "node tools/test-cache-inputs.mjs",
    "db:generate": "nx run data-access:generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "nx run data-access:generate && prisma db seed",
    "docker:up": "node tools/docker-up.mjs",
    "docker:down": "node tools/docker-down.mjs",
    "docker:reset": "node tools/docker-reset.mjs",
    "test:docker-runner": "node --test tools/test-docker-runner.mjs tools/test-dev-api.mjs",
    "db:setup-test": "node tools/setup-test-database.mjs",
    "docker:dev": "node tools/docker-up.mjs --dev",
    "docker:dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "7.10.1",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "@tanstack/react-query": "5.104.5",
    "@internationalized/date": "3.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "three": "0.186.1",
    "postprocessing": "6.39.5",
    "motion": "14.6.0",
    "zod": "4.6.7",
    "rxjs": "7.8.2",
    "reflect-metadata": "0.2.2",
    "pg": "8.23.1",
    "@prisma/adapter-pg": "7.10.1",
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "nx": "23.3.1",
    "@nx/devkit": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/eslint-plugin": "23.3.1",
    "@nestjs/testing": "11.2.8",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "eslint-config-prettier": "10.1.8",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/pg": "8.23.1",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "prisma": "7.10.1",
    "@typescript-eslint/parser": "8.72.0",
    "tsc-alias": "1.9.9",
    "storybook": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/user-event": "14.6.8"
  },
  "nx": {
    "includedScripts": []
  }
}
