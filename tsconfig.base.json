{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@torob-ticket/contracts": [
        "libs/contracts/src/index.ts"
      ],
      "@torob-ticket/domain": [
        "libs/domain/src/index.ts"
      ],
      "@torob-ticket/fixtures": [
        "libs/fixtures/src/index.ts"
      ],
      "@torob-ticket/provider-adapters": [
        "libs/provider-adapters/src/index.ts"
      ],
      "@torob-ticket/data-access": [
        "libs/data-access/src/index.ts"
      ],
      "@torob-ticket/ui": [
        "libs/ui/src/index.ts"
      ],
      "@torob-ticket/graphics": [
        "libs/graphics/src/index.ts"
      ],
      "@torob-ticket/client": [
        "libs/client/src/index.ts"
      ]
    }
  }
}
