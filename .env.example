# Optional. Defaults work without copying this file.
TOROBTICKET_PORT=4300
# Set a distinct project name for an isolated stack and named database volume.
COMPOSE_PROJECT_NAME=torobticket

# Optional Docker build package registry; the official npm registry is the default.
# For npmmirror, set this to https://registry.npmmirror.com.
TOROBTICKET_NPM_REGISTRY=https://registry.npmjs.org

# Optional Prisma engine download mirror for Docker build and initialization.
# For npmmirror, set this to https://npmmirror.com/mirrors/prisma.
TOROBTICKET_PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh

# Optional final HTTP(S) origin for absolute social-preview metadata at build time.
# Leave empty for local-only builds; do not invent a deployment hostname.
TOROBTICKET_PUBLIC_ORIGIN=

# Optional Docker development fallback when the host misses file notifications.
TOROBTICKET_DEV_POLLING=false
