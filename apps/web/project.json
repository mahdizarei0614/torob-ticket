{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [
    "scope:web",
    "type:app"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/web/tsconfig.json"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/vite-brand-metadata.mts"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/web/vite.config.mts"
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/web"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/vite-brand-metadata.mts",
        {
          "env": "TOROBTICKET_PUBLIC_ORIGIN"
        }
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/web/vite.config.mts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project web"
      }
    }
  }
}
