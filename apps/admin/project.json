{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "tags": [
    "scope:admin",
    "type:app"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/admin"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/admin/tsconfig.json"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/vite-brand-metadata.mts",
        "{workspaceRoot}/tools/vite-separated-sites.mts"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/admin/vite.config.mts"
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/admin"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/vite-brand-metadata.mts",
        {
          "env": "TOROBTICKET_PUBLIC_ORIGIN"
        },
        "{workspaceRoot}/tools/vite-separated-sites.mts"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/admin/vite.config.mts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project admin"
      }
    }
  }
}
